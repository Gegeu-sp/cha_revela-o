rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Palpites do Bolão: leitura pública para o placar e envio liberado (bloqueando dados mock)
    match /guesses/{guessId} {
      allow read, delete: if true;
      allow create, update: if guessId != 'mock_1' && guessId != 'mock_2' && guessId != 'mock_3';
    }
    
    // Configurações do evento (cotas, chave Pix, data e nomes dos bebês)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Histórico oficial de sorteios do bolão
    match /draws/{drawId} {
      allow read, write: if true;
    }
  }
}
